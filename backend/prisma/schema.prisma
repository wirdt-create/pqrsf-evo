generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  ATENCION_CLIENTE
  LIDER_AREA

  @@map("rol_usuario")
}

enum EstadoPqrsf {
  RADICADA
  ESCALADA
  EN_VALIDACION
  RESUELTA
  EN_GESTION_REPLICA
  CERRADA

  @@map("estado_pqrsf")
}

enum MotivoRechazoRespuesta {
  ERROR_ORTOGRAFICO
  INCOHERENTE
  TONO_INADECUADO
  INFORMACION_INCOMPLETA
  NO_RESUELVE_EL_FONDO
  OTRO

  @@map("motivo_rechazo_respuesta")
}

model Usuario {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre                String
  correo                String             @unique
  password_hash         String
  rol                   RolUsuario
  area                  String?
  activo                Boolean            @default(true)
  creado_en             DateTime           @default(now()) @db.Timestamptz(6)
  asignaciones          MatrizAsignacion[]
  pqrsf_asignadas       Pqrsf[]            @relation("PqrsfResponsable")
  respuestas_propuestas Pqrsf[]            @relation("PqrsfRespuestaPropuestaPor")
  avances               BitacoraAvance[]
  acciones_correctivas  AccionCorrectiva[]
  logs_auditoria        LogAuditoria[]

  @@map("usuarios")
}

model ConfigSla {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_pqrsf           String  @unique
  dias_habiles_limite  Int
  dias_alerta_amarilla Int
  activo               Boolean @default(true)

  @@map("config_sla")
}

model MatrizAsignacion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proceso            String
  tipo_pqrsf         String
  agente_responsable String?  @db.Uuid
  area               String
  activo             Boolean  @default(true)
  agente             Usuario? @relation(fields: [agente_responsable], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("matriz_asignacion")
}

model Pqrsf {
  id                           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_radicado                  String                  @unique
  nombre_solicitante           String
  id_nit_solicitante           String
  correo_solicitante           String
  tipo_usuario                 String
  tipo_pqrsf                   String
  proceso_relacionado          String
  descripcion_solicitud        String
  fecha_radicacion             DateTime                @default(now()) @db.Timestamptz(6)
  estado                       EstadoPqrsf             @default(RADICADA)
  responsable_id               String?                 @db.Uuid
  fecha_inicio_gestion         DateTime?               @db.Timestamptz(6)
  fecha_limite_sla             DateTime?               @db.Date
  descripcion_causa            String?
  es_error_humano              Boolean?
  descripcion_solucion         String?
  tipo_solucion                String?
  metodo_cierre                String?
  amerita_accion_correctiva    Boolean?                @default(false)
  cliente_satisfecho           Boolean?
  explicacion_insatisfaccion   String?
  repetibilidad                String?
  encuesta_enviada             Boolean                 @default(false)
  num_replicas                 Int                     @default(0)
  replicas_agotadas            Boolean                 @default(false)
  motivo_escalamiento          String?
  respuesta_propuesta          String?
  respuesta_propuesta_por      String?                 @db.Uuid
  respuesta_propuesta_en       DateTime?               @db.Timestamptz(6)
  motivo_rechazo_respuesta     MotivoRechazoRespuesta?
  comentario_rechazo_respuesta String?
  creado_en                    DateTime                @default(now()) @db.Timestamptz(6)
  actualizado_en               DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  responsable                  Usuario?                @relation("PqrsfResponsable", fields: [responsable_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  respuesta_propuesta_usuario  Usuario?                @relation("PqrsfRespuestaPropuestaPor", fields: [respuesta_propuesta_por], references: [id], onDelete: SetNull, onUpdate: Cascade)
  avances                      BitacoraAvance[]
  acciones_correctivas         AccionCorrectiva[]
  encuestas                    Encuesta[]

  @@index([fecha_radicacion], map: "idx_pqrsf_fecha_radicacion")
  @@index([estado], map: "idx_pqrsf_estado")
  @@index([responsable_id], map: "idx_pqrsf_responsable")
  @@map("pqrsf")
}

model BitacoraAvance {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pqrsf_id    String   @db.Uuid
  usuario_id  String?  @db.Uuid
  descripcion String
  adjunto_url String?
  creado_en   DateTime @default(now()) @db.Timestamptz(6)
  pqrsf       Pqrsf    @relation(fields: [pqrsf_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  usuario     Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("bitacora_avances")
}

model AccionCorrectiva {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pqrsf_id_origen    String    @db.Uuid
  causa_raiz         String
  descripcion_accion String
  responsable_id     String?   @db.Uuid
  fecha_compromiso   DateTime? @db.Date
  estado             String    @default("ABIERTA")
  fecha_verificacion DateTime? @db.Date
  evidencias_url     String?
  pqrsf              Pqrsf     @relation(fields: [pqrsf_id_origen], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsable        Usuario?  @relation(fields: [responsable_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("acciones_correctivas")
}

model Encuesta {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pqrsf_id      String    @db.Uuid
  enviada_en    DateTime  @default(now()) @db.Timestamptz(6)
  respondida    Boolean   @default(false)
  respondida_en DateTime? @db.Timestamptz(6)
  satisfecho    Boolean?
  comentario    String?
  pqrsf         Pqrsf     @relation(fields: [pqrsf_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("encuestas")
}

model LogAuditoria {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fecha              DateTime @default(now()) @db.Timestamptz(6)
  usuario_id         String?  @db.Uuid
  entidad_modificada String
  campo              String
  valor_anterior     String?
  valor_nuevo        String?
  usuario            Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@map("log_auditoria")
}
