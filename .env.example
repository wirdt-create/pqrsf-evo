# Variables de desarrollo. docker-compose.yml usa estos mismos valores por defecto
# para que Codespaces pueda iniciar sin un archivo .env. Nunca uses estos secretos en producción.
POSTGRES_DB=pqrsf_evo
POSTGRES_USER=pqrsf_app
POSTGRES_PASSWORD=local_dev_postgres_only_2026
POSTGRES_PORT=5432

REDIS_PASSWORD=local_dev_redis_only_2026
REDIS_PORT=6379

MINIO_ROOT_USER=pqrsf_minio
MINIO_ROOT_PASSWORD=local_dev_minio_only_2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

API_PORT=3000
FRONTEND_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Solo para docker-compose.prod.yml: SMTP de un proveedor real, no Mailpit.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
VITE_API_URL=http://localhost:3000
